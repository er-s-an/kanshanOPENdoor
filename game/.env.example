# 看山任意门 —— Chat 网关环境变量。复制为 .env 后填写。.env 永不提交。
# 只允许知乎直答 API；禁止接其它模型。

# 知乎开放平台 Access Secret（运行时对话鉴权，Bearer 方式）
# 缺省时网关依次尝试：此环境变量 → 本地文件（ZHIHU_SECRET_FILE）→ 降级模式
ZHIHU_ACCESS_SECRET=

# 可选：Access Secret 所在文件（默认读取 /Users/xiejiachen/zhihu-hackathon-2026/.access_secret）
# ZHIHU_SECRET_FILE=

# 直答上游地址（本地调试可指向 mock：ZHIDA_BASE_URL=http://127.0.0.1:8791/v1）
# 默认 https://developer.zhihu.com/v1

# 运行时对话模型档位：zhida-fast-1p5 / zhida-thinking-1p5 / zhida-agent
ZHIDA_MODEL=zhida-fast-1p5

# 网关监听端口（vite dev 会把 /api 代理到这里）
CHAT_PORT=8790

# 调试开关：KANSHAN_NO_CACHE=1 关闭 LLM 响应磁盘缓存
