{
  "name": "kanshan-portal-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "看山任意门 · 游戏运行时前端（Vite + React + TS + 知乎直答网关）",
  "scripts": {
    "dev": "concurrently -k -n gateway,web -c yellow,cyan \"npm:dev:gateway\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:gateway": "node server/gateway.mjs",
    "dev:mock": "node server/mock-upstream.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "start": "node server/gateway.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "dompurify": "^3.2.4",
    "marked": "^15.0.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "typescript": "^5.7.0",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=20"
  }
}
