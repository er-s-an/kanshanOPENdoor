                "value": 0
              }
            ],
            "next": "myopic_end_exhausted",
            "text": "体力耗尽，你只能停下。"
          },
          {
            "id": "myopic_time",
            "when": [
              {
                "key": "time",
                "op": "lte",
                "value": 0
              }
